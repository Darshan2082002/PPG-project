# ==============================================================
#  DATASETS  (too large for git — use DVC or Git LFS)
# ==============================================================

# Raw MIMIC-IV waveform data
MIMIC_2/
MIMIC-IV*/
data/mimic_iv/
data/mimic-iv/
data/mimic/

# Raw PTT PPG data
Pulse Transit Time PPG Dataset/
data/ptt_ppg/
data/ptt-ppg/
data/ptt/

# Any other large data directories
data/raw/
data/external/
data/interim/
data/processed/


# ==============================================================
#  ML PIPELINE — GENERATED OUTPUTS
# ==============================================================

# Preprocessed dataset (regenerated by fuse_datasets.py)
outputs/dataset.npz

# Feature files (regenerated by feature_extraction.py)
outputs/features_*.parquet
outputs/features_*.csv

# ---------- Model checkpoints (large binary files) ----------

# Keras / TensorFlow
outputs/**/*.h5
outputs/**/*.keras
outputs/**/*.pb
outputs/**/saved_model/
outputs/**/variables/
outputs/**/checkpoint
outputs/**/*.index
outputs/**/*.data-*

# XGBoost
outputs/**/xgb_model.ubj
outputs/**/xgb_model.json
outputs/**/xgb_model.bin

# ---------- TFLite quantized models ----------
outputs/**/*.tflite
outputs/export/**/*.tflite

# ---------- TensorBoard logs ----------
outputs/logs/
outputs/**/logs/

# ---------- Benchmark results (regenerated by benchmark.py) ----------
outputs/benchmark_results/
outputs/benchmark_snapshot.json

# ---------- Per-model results/ directories (regenerated) ----------
# These hold confusion matrices, ROC/PR curves, history plots, etc.
outputs/*/results/

# ---------- Training plots ----------
outputs/**/history_*.png
outputs/**/training_history.png

# ---------- Standalone evaluation outputs ----------
outputs/confusion_matrix*.png
outputs/training_history.png
outputs/classification_report.txt

# Keep the outputs/ directory in git
!outputs/.gitkeep


# ==============================================================
#  TINYML / ESP32-S3 FIRMWARE GENERATED FILES
# ==============================================================

# Auto-generated C headers (regenerated by export_models.py)
firmware/src/model.h
firmware/src/model_data_*.h
outputs/export/**/*.h
outputs/export/**/*.c
outputs/export/**/*.cpp

# Keep hand-written firmware sources
!firmware/src/main.cpp
!firmware/src/ppg_inference.h
!firmware/src/ppg_inference.cpp


